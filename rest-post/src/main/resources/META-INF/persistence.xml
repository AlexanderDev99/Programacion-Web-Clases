<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="dbposts" transaction-type="RESOURCE_LOCAL">
        <class>com.programacion.web.db.User</class>

        <properties>
            <!-- Configuración de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>

            <!-- Configuración de JDBC -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://ep-old-night-at4wtlha-pooler.c-9.us-east-1.aws.neon.tech/neondb"/>
            <property name="jakarta.persistence.jdbc.user" value="neondb_owner"/>
            <property name="jakarta.persistence.jdbc.password" value="npg_BYuxZ5UbHe8E"/>
        </properties>

    </persistence-unit>
</persistence>
